# URL de tu evento de Calendly para el agendamiento de reuniones virtuales
# (ver "Agendar reunión virtual" en el modal de cotización).
# 1. Crea una cuenta gratis en https://calendly.com
# 2. Crea un evento tipo "Videollamada" con Google Meet integrado
# 3. Copia el link de ese evento (ej. https://calendly.com/tu-usuario/videollamada)
# Debe empezar con NEXT_PUBLIC_ porque se usa en el navegador (widget embebido).
NEXT_PUBLIC_CALENDLY_URL=

# Webhook opcional para registrar cada lead (cotización por WhatsApp/correo o
# reunión agendada) en un CRM o en Google Sheets. Puede ser:
# - Un Web App de Google Apps Script conectado a una hoja de cálculo
# - Un webhook de Zapier / Make que reenvíe a tu CRM (HubSpot, Pipedrive, etc.)
# Si se deja vacío, los leads solo quedan en el log del servidor.
LEAD_WEBHOOK_URL=

# ── SEO ──────────────────────────────────────────────────────────────────
# Dominio público del sitio (sin "/" final). Úsalo cuando conectes tu propio
# dominio — se usa en canonical, sitemap.xml, robots.txt y Open Graph.
# Mientras tanto queda el dominio de Vercel por defecto.
NEXT_PUBLIC_SITE_URL=https://agendatur.vercel.app

# Código de verificación de Google Search Console (Configuración >
# Verificación de propiedad > etiqueta HTML > solo el valor de "content").
NEXT_PUBLIC_GSC_VERIFICATION=

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Si se deja
# vacío, el script de Analytics no se carga.
NEXT_PUBLIC_GA_ID=
